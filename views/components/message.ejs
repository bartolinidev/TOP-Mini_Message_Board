<section class="message">
  <div class="text"><%= text %></div>
  <div class="wrapper">
    <%- include('../../public/svg/account-circle-outline.svg') %>
    <div class="user"><%= user %></div>
    <div class="added">
      <%= new Date(added).toLocaleString('en-GB', { year: 'numeric', month:
      '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12:
      false }) %>
    </div>
  </div>
  <a href="/messages/<%= id %>" class="log-btn">Log</a>
</section>
