<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <main>
      <% messages.forEach(m => { %>
      <%- include('components/message.ejs', { text: m.text, user: m.user, added: m.added }) %>
      <% }) %>
    </main>
    <div class="bottom-wrapper">
      <%- include('components/nav.ejs') %> <%- include('components/footer.ejs')
      %>
    </div>
  </body>
</html>
